  <script>
    // Fetch hero settings and populate the hero card module
    (function() {
      fetch('/api/settings/hero-display')
        .then(response => response.json())
        .then(data => {
          const heroImage = document.getElementById('hero-card-image');
          const heroTitle = document.getElementById('hero-card-title');
          const heroSubtitle = document.getElementById('hero-card-subtitle');
          const heroDescription = document.getElementById('hero-card-description');
          
          if (data.hero_card_image_url && heroImage) {
            heroImage.src = data.hero_card_image_url;
          }
          if (data.hero_card_title && heroTitle) {
            heroTitle.textContent = data.hero_card_title;
          }
          if (data.hero_card_subtitle && heroSubtitle) {
            heroSubtitle.textContent = data.hero_card_subtitle;
          }
          if (data.hero_card_description && heroDescription) {
            heroDescription.textContent = data.hero_card_description;
          }
        })
        .catch(err => console.log('Hero settings not loaded:', err));
    })();
